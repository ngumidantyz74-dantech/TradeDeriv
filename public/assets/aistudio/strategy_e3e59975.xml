<xml xmlns="https://developers.google.com/blockly/xml" is_dbot="true" collection="false">
  <variables>
    <variable id="v_initial_stake">initial_stake</variable>
    <variable id="v_current_stake">current_stake</variable>
    <variable id="v_take_profit">take_profit</variable>
    <variable id="v_stop_loss">stop_loss</variable>
    <variable id="v_max_losses">max_losses</variable>
    <variable id="v_loss_count">loss_count</variable>
    <variable id="v_total_profit">total_profit</variable>
    <variable id="v_ema_fast">ema_fast</variable>
    <variable id="v_ema_slow">ema_slow</variable>
    <variable id="v_rsi_val">rsi_val</variable>
  </variables>

  <!-- 1. Trade Parameters -->
  <block type="trade_definition" id="trade_def_root" deletable="false" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="td_market" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ100V</field>
        <next>
          <block type="trade_definition_tradetype" id="td_tradetype" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">callput</field>
            <field name="TRADETYPE_LIST">callput</field>
            <next>
              <block type="trade_definition_contracttype" id="td_contracttype" deletable="false" movable="false">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="td_interval" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="td_restart_bs" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="td_restart_err" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>

    <!-- Run Once at Start: Risk Parameters -->
    <statement name="INITIALIZATION">
      <block type="variables_set" id="init_stake">
        <field name="VAR" id="v_initial_stake">initial_stake</field>
        <value name="VALUE">
          <block type="math_number" id="num_init_stake">
            <field name="NUM">1</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="init_curr_stake">
            <field name="VAR" id="v_current_stake">current_stake</field>
            <value name="VALUE">
              <block type="variables_get" id="get_init_stake_1">
                <field name="VAR" id="v_initial_stake">initial_stake</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="init_tp">
                <field name="VAR" id="v_take_profit">take_profit</field>
                <value name="VALUE">
                  <block type="math_number" id="num_tp">
                    <field name="NUM">10</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="init_sl">
                    <field name="VAR" id="v_stop_loss">stop_loss</field>
                    <value name="VALUE">
                      <block type="math_number" id="num_sl">
                        <field name="NUM">8</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="init_max_loss">
                        <field name="VAR" id="v_max_losses">max_losses</field>
                        <value name="VALUE">
                          <block type="math_number" id="num_max_loss">
                            <field name="NUM">3</field>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set" id="init_loss_cnt">
                            <field name="VAR" id="v_loss_count">loss_count</field>
                            <value name="VALUE">
                              <block type="math_number" id="num_loss_cnt">
                                <field name="NUM">0</field>
                              </block>
                            </value>
                            <next>
                              <block type="variables_set" id="init_tot_prof">
                                <field name="VAR" id="v_total_profit">total_profit</field>
                                <value name="VALUE">
                                  <block type="math_number" id="num_tot_prof">
                                    <field name="NUM">0</field>
                                  </block>
                                </value>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>

    <!-- Trade Options -->
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="td_options" deletable="false" movable="false">
        <mutation xmlns="http://www.w3.org/1999/xhtml" has_first_barrier="false" has_second_barrier="false" has_prediction="false"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <value name="DURATION">
          <shadow type="math_number" id="dur_val">
            <field name="NUM">5</field>
          </shadow>
        </value>
        <value name="AMOUNT">
          <shadow type="math_number" id="amt_shadow">
            <field name="NUM">1</field>
          </shadow>
          <block type="variables_get" id="get_curr_stake">
            <field name="VAR" id="v_current_stake">current_stake</field>
          </block>
        </value>
      </block>
    </statement>
  </block>

  <!-- 2. Purchase Conditions (EMA 9/21 + RSI 14 Filter) -->
  <block type="before_purchase" id="before_purch_root" deletable="false" x="0" y="520">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="variables_set" id="set_ema_fast">
        <field name="VAR" id="v_ema_fast">ema_fast</field>
        <value name="VALUE">
          <block type="ema" id="calc_ema_fast">
            <value name="INPUT">
              <block type="ohlc_values" id="ohlc_close_1">
                <field name="OHLCFIELD_LIST">close</field>
                <field name="CANDLEINTERVAL_LIST">default</field>
              </block>
            </value>
            <value name="PERIOD">
              <shadow type="math_number" id="p_ema9">
                <field name="NUM">9</field>
              </shadow>
            </value>
          </block>
        </value>
        <next>
          <block type="variables_set" id="set_ema_slow">
            <field name="VAR" id="v_ema_slow">ema_slow</field>
            <value name="VALUE">
              <block type="ema" id="calc_ema_slow">
                <value name="INPUT">
                  <block type="ohlc_values" id="ohlc_close_2">
                    <field name="OHLCFIELD_LIST">close</field>
                    <field name="CANDLEINTERVAL_LIST">default</field>
                  </block>
                </value>
                <value name="PERIOD">
                  <shadow type="math_number" id="p_ema21">
                    <field name="NUM">21</field>
                  </shadow>
                </value>
              </block>
            </value>
            <next>
              <block type="variables_set" id="set_rsi">
                <field name="VAR" id="v_rsi_val">rsi_val</field>
                <value name="VALUE">
                  <block type="rsi" id="calc_rsi">
                    <value name="INPUT">
                      <block type="ohlc_values" id="ohlc_close_3">
                        <field name="OHLCFIELD_LIST">close</field>
                        <field name="CANDLEINTERVAL_LIST">default</field>
                      </block>
                    </value>
                    <value name="PERIOD">
                      <shadow type="math_number" id="p_rsi14">
                        <field name="NUM">14</field>
                      </shadow>
                    </value>
                  </block>
                </value>
                <next>
                  <block type="controls_if" id="if_entry">
                    <mutation elseif="1"></mutation>
                    <!-- Bullish Signal: EMA9 > EMA21 and 52 < RSI < 70 -->
                    <value name="IF0">
                      <block type="logic_operation" id="and_bull_1">
                        <field name="OP">AND</field>
                        <value name="A">
                          <block type="logic_compare" id="cmp_ema_bull">
                            <field name="OP">GT</field>
                            <value name="A">
                              <block type="variables_get" id="g_ef_1">
                                <field name="VAR" id="v_ema_fast">ema_fast</field>
                              </block>
                            </value>
                            <value name="B">
                              <block type="variables_get" id="g_es_1">
                                <field name="VAR" id="v_ema_slow">ema_slow</field>
                              </block>
                            </value>
                          </block>
                        </value>
                        <value name="B">
                          <block type="logic_operation" id="and_bull_2">
                            <field name="OP">AND</field>
                            <value name="A">
                              <block type="logic_compare" id="cmp_rsi_bull_low">
                                <field name="OP">GT</field>
                                <value name="A">
                                  <block type="variables_get" id="g_rsi_1">
                                    <field name="VAR" id="v_rsi_val">rsi_val</field>
                                  </block>
                                </value>
                                <value name="B">
                                  <block type="math_number" id="n_52">
                                    <field name="NUM">52</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <value name="B">
                              <block type="logic_compare" id="cmp_rsi_bull_high">
                                <field name="OP">LT</field>
                                <value name="A">
                                  <block type="variables_get" id="g_rsi_2">
                                    <field name="VAR" id="v_rsi_val">rsi_val</field>
                                  </block>
                                </value>
                                <value name="B">
                                  <block type="math_number" id="n_70">
                                    <field name="NUM">70</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                          </block>
                        </value>
                      </block>
                    </value>
                    <statement name="DO0">
                      <block type="purchase" id="buy_call">
                        <field name="PURCHASE_LIST">CALL</field>
                      </block>
                    </statement>

                    <!-- Bearish Signal: EMA9 < EMA21 and 30 < RSI < 48 -->
                    <value name="IF1">
                      <block type="logic_operation" id="and_bear_1">
                        <field name="OP">AND</field>
                        <value name="A">
                          <block type="logic_compare" id="cmp_ema_bear">
                            <field name="OP">LT</field>
                            <value name="A">
                              <block type="variables_get" id="g_ef_2">
                                <field name="VAR" id="v_ema_fast">ema_fast</field>
                              </block>
                            </value>
                            <value name="B">
                              <block type="variables_get" id="g_es_2">
                                <field name="VAR" id="v_ema_slow">ema_slow</field>
                              </block>
                            </value>
                          </block>
                        </value>
                        <value name="B">
                          <block type="logic_operation" id="and_bear_2">
                            <field name="OP">AND</field>
                            <value name="A">
                              <block type="logic_compare" id="cmp_rsi_bear_high">
                                <field name="OP">LT</field>
                                <value name="A">
                                  <block type="variables_get" id="g_rsi_3">
                                    <field name="VAR" id="v_rsi_val">rsi_val</field>
                                  </block>
                                </value>
                                <value name="B">
                                  <block type="math_number" id="n_48">
                                    <field name="NUM">48</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <value name="B">
                              <block type="logic_compare" id="cmp_rsi_bear_low">
                                <field name="OP">GT</field>
                                <value name="A">
                                  <block type="variables_get" id="g_rsi_4">
                                    <field name="VAR" id="v_rsi_val">rsi_val</field>
                                  </block>
                                </value>
                                <value name="B">
                                  <block type="math_number" id="n_30">
                                    <field name="NUM">30</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                          </block>
                        </value>
                      </block>
                    </value>
                    <statement name="DO1">
                      <block type="purchase" id="buy_put">
                        <field name="PURCHASE_LIST">PUT</field>
                      </block>
                    </statement>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>

  <!-- 3. Sell Conditions -->
  <block type="during_purchase" id="during_purch_root" deletable="false" x="0" y="960">
    <statement name="DURING_PURCHASE_STACK">
      <block type="controls_if" id="if_sell">
        <value name="IF0">
          <block type="check_sell" id="chk_sell"></block>
        </value>
      </block>
    </statement>
  </block>

  <!-- 4. Restart Trading Conditions (Money Management & Stop Limits) -->
  <block type="after_purchase" id="after_purch_root" deletable="false" x="0" y="1120">
    <statement name="AFTERPURCHASE_STACK">
      <block type="math_change" id="upd_tot_profit">
        <field name="VAR" id="v_total_profit">total_profit</field>
        <value name="DELTA">
          <shadow type="math_number" id="delta_sh">
            <field name="NUM">1</field>
          </shadow>
          <block type="read_details" id="read_prof">
            <field name="DETAIL_INDEX">4</field>
          </block>
        </value>
        <next>
          <block type="controls_if" id="if_win_loss">
            <mutation else="1"></mutation>
            <value name="IF0">
              <block type="contract_check_result" id="chk_win">
                <field name="CHECK_RESULT">win</field>
              </block>
            </value>
            <statement name="DO0">
              <block type="variables_set" id="reset_losses">
                <field name="VAR" id="v_loss_count">loss_count</field>
                <value name="VALUE">
                  <block type="math_number" id="n_zero_1">
                    <field name="NUM">0</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="reset_stake_win">
                    <field name="VAR" id="v_current_stake">current_stake</field>
                    <value name="VALUE">
                      <block type="variables_get" id="g_init_st_2">
                        <field name="VAR" id="v_initial_stake">initial_stake</field>
                      </block>
                    </value>
                  </block>
                </next>
              </block>
            </statement>
            <statement name="ELSE">
              <block type="math_change" id="inc_losses">
                <field name="VAR" id="v_loss_count">loss_count</field>
                <value name="DELTA">
                  <shadow type="math_number" id="n_one_1">
                    <field name="NUM">1</field>
                  </shadow>
                </value>
                <next>
                  <block type="controls_if" id="if_max_loss_cap">
                    <mutation else="1"></mutation>
                    <value name="IF0">
                      <block type="logic_compare" id="cmp_max_losses">
                        <field name="OP">GTE</field>
                        <value name="A">
                          <block type="variables_get" id="g_lc_1">
                            <field name="VAR" id="v_loss_count">loss_count</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="variables_get" id="g_ml_1">
                            <field name="VAR" id="v_max_losses">max_losses</field>
                          </block>
                        </value>
                      </block>
                    </value>
                    <statement name="DO0">
                      <block type="variables_set" id="reset_losses_cap">
                        <field name="VAR" id="v_loss_count">loss_count</field>
                        <value name="VALUE">
                          <block type="math_number" id="n_zero_2">
                            <field name="NUM">0</field>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set" id="reset_stake_cap">
                            <field name="VAR" id="v_current_stake">current_stake</field>
                            <value name="VALUE">
                              <block type="variables_get" id="g_init_st_3">
                                <field name="VAR" id="v_initial_stake">initial_stake</field>
                              </block>
                            </value>
                          </block>
                        </next>
                      </block>
                    </statement>
                    <statement name="ELSE">
                      <block type="variables_set" id="scale_stake">
                        <field name="VAR" id="v_current_stake">current_stake</field>
                        <value name="VALUE">
                          <block type="math_arithmetic" id="mult_stake">
                            <field name="OP">MULTIPLY</field>
                            <value name="A">
                              <block type="variables_get" id="g_cs_1">
                                <field name="VAR" id="v_current_stake">current_stake</field>
                              </block>
                            </value>
                            <value name="B">
                              <shadow type="math_number" id="n_mult">
                                <field name="NUM">1.3</field>
                              </shadow>
                            </value>
                          </block>
                        </value>
                      </block>
                    </statement>
                  </block>
                </next>
              </block>
            </statement>
            <next>
              <!-- Check Take Profit and Stop Loss before trading again -->
              <block type="controls_if" id="if_continue">
                <mutation else="1"></mutation>
                <value name="IF0">
                  <block type="logic_operation" id="and_limits">
                    <field name="OP">AND</field>
                    <value name="A">
                      <block type="logic_compare" id="cmp_tp">
                        <field name="OP">LT</field>
                        <value name="A">
                          <block type="variables_get" id="g_tp_prof">
                            <field name="VAR" id="v_total_profit">total_profit</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="variables_get" id="g_tp_lim">
                            <field name="VAR" id="v_take_profit">take_profit</field>
                          </block>
                        </value>
                      </block>
                    </value>
                    <value name="B">
                      <block type="logic_compare" id="cmp_sl">
                        <field name="OP">GT</field>
                        <value name="A">
                          <block type="variables_get" id="g_sl_prof">
                            <field name="VAR" id="v_total_profit">total_profit</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="math_single" id="neg_sl">
                            <field name="OP">NEG</field>
                            <value name="NUM">
                              <block type="variables_get" id="g_sl_lim">
                                <field name="VAR" id="v_stop_loss">stop_loss</field>
                              </block>
                            </value>
                          </block>
                        </value>
                      </block>
                    </value>
                  </block>
                </value>
                <statement name="DO0">
                  <block type="trade_again" id="do_trade_again"></block>
                </statement>
                <statement name="ELSE">
                  <block type="notify" id="notify_done">
                    <field name="NOTIFICATION_TYPE">success</field>
                    <field name="NOTIFICATION_SOUND">earned-money</field>
                    <value name="MESSAGE">
                      <shadow type="text" id="msg_done">
                        <field name="TEXT">Target reached or Stop Loss triggered. Session stopped.</field>
                      </shadow>
                    </value>
                  </block>
                </statement>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>
