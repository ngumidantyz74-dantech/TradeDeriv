# Server & Security
PORT=3000
NODE_ENV=development
APP_URL="https://your-service.onrender.com"
FRONTEND_URL="https://your-service.onrender.com"
JWT_SECRET="replace-with-strong-64-char-random-secret"
BOT_GATE_JWT_SECRET="replace-with-strong-64-char-bot-gate-secret"
TOKEN_ENCRYPTION_KEY="replace-with-32-byte-hex-or-passphrase"
ADMIN_PRIVATE_SLUG="pf-ops-9482"
VITE_ADMIN_PRIVATE_SLUG="pf-ops-9482"

# Neon PostgreSQL Connection String (must include ?sslmode=require for Neon)
DATABASE_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Official Deriv Third-Party App Configuration
DERIV_APP_ID="1089"
VITE_DERIV_APP_ID="1089"
DERIV_CLIENT_SECRET=""
DERIV_OAUTH_URL="https://auth.deriv.com/oauth2/auth"
DERIV_OAUTH_REDIRECT_URI="https://your-service.onrender.com/api/deriv/oauth/callback"
DERIV_OAUTH_SCOPES="trade account_manage"
DERIV_WS_URL="wss://red.derivws.com/websockets/v3"

# Transactional Email (Brevo)
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="noreply@tradederiv.app"
BREVO_SENDER_NAME="TradeDeriv"

# Gemini API (optional platform-injected)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
